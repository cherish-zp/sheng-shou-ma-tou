{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShengShouMaTou",
  "mainBinaryName": "ShengShouMaTou",
  "version": "0.1.1",
  "identifier": "com.cherish.shengshoumatou",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "圣手码头",
        "width": 1080,
        "height": 720,
        "minWidth": 940,
        "minHeight": 620,
        "center": true
      }
    ],
    "trayIcon": {
      "id": "pier-tray",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "tooltip": "圣手码头"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}